---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { product } from '../../data/site';
---

<BaseLayout title="Thanks for your interest" description="Your Jurnl free trial." noindex>
  <section class="page-hero">
    <div class="container stack" style="--gap: 18px">
      <h1 class="h1" style="font-size: clamp(2.125rem, 4.2vw, 3.25rem)">Thanks for your interest in Jurnl</h1>
      <p class="lead muted">We'll email you a link to download it shortly.</p>
    </div>
  </section>
  <div class="container page-body">
    <div class="page-body__content stack" style="--gap: 16px">
      <p>
        If it hasn't arrived within a business day, check your junk or spam folder, or email
        <a href={`mailto:${product.email}`}>{product.email}</a>.
      </p>
      <p>While you wait, see <a href="/features/">what Jurnl does</a> or read about <a href="/security/">how your data is kept safe</a>.</p>
    </div>
  </div>
</BaseLayout>
