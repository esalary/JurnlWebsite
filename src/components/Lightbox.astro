---
// Full-size screenshot viewer, included once in BaseLayout.
// Any element with data-zoom="<large image url>" opens it; elements sharing data-zoom-group
// can be stepped through with the arrows, the keyboard (← →) or a swipe.
// Closes with Esc, the × button or a click outside the picture. Clicking the picture shows it
// at full size (scroll to move around), when it is larger than the screen.
---

<dialog class="lightbox" data-lightbox aria-label="Screenshot">
  <div class="lightbox__stage" data-stage>
    <img class="lightbox__img" data-img alt="" />
  </div>
  <div class="lightbox__bar">
    <p class="lightbox__caption" data-caption></p>
    <p class="lightbox__meta"><span data-count></span><span class="lightbox__tip" data-tip></span></p>
  </div>
  <button type="button" class="lightbox__btn lightbox__close" data-close aria-label="Close">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <button type="button" class="lightbox__btn lightbox__prev" data-prev aria-label="Previous screenshot">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <button type="button" class="lightbox__btn lightbox__next" data-next aria-label="Next screenshot">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
  </button>
</dialog>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(11, 15, 27);
    color: #f7f7f2;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgba(9, 13, 24, 0.6);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .lightbox__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 64px 76px 8px;
    overflow: hidden;
  }
  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    cursor: zoom-in;
    user-select: none;
  }
  .lightbox__img.is-small {
    cursor: default;
  }
  /* Full size: the picture at its natural size, scrolled around inside the stage */
  .lightbox.is-actual .lightbox__stage {
    place-items: start;
    overflow: auto;
    padding: 64px 24px 8px;
  }
  .lightbox.is-actual .lightbox__img {
    max-width: none;
    max-height: none;
    margin: auto;
    cursor: zoom-out;
  }
  .lightbox__bar {
    padding: 12px 24px 20px;
    text-align: center;
  }
  .lightbox__caption {
    margin: 0 auto;
    max-width: 62rem;
    font-size: 1rem;
    line-height: 1.5;
  }
  .lightbox__meta {
    margin: 6px 0 0;
    font-size: 0.875rem;
    color: rgba(247, 247, 242, 0.7);
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .lightbox__meta span:empty {
    display: none;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
  }
  .lightbox__btn:hover {
    background: rgba(255, 255, 255, 0.26);
  }
  .lightbox__btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  .lightbox__close {
    top: 12px;
    right: 14px;
  }
  .lightbox__prev,
  .lightbox__next {
    top: calc(50% - 40px);
  }
  .lightbox__prev {
    left: 14px;
  }
  .lightbox__next {
    right: 14px;
  }
  .lightbox__btn[hidden] {
    display: none;
  }
  html.lightbox-open {
    overflow: hidden;
  }
  @media (max-width: 700px) {
    .lightbox__stage {
      padding: 64px 8px 8px;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 14px;
      width: 44px;
      height: 44px;
    }
    .lightbox__bar {
      padding: 10px 64px 18px;
    }
  }

  /* Enlarge hint on screenshots that open the viewer */
  .shot__zoom {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    font: inherit;
    color: inherit;
  }
  .shot__zoom:focus-visible {
    outline: 3px solid var(--accent, #e4572e);
    outline-offset: 3px;
  }
  .shot__hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    background: rgba(14, 20, 36, 0.82);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    pointer-events: none;
  }
  .shot__zoom:hover .shot__hint,
  .shot__zoom:focus-visible .shot__hint {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .shot__hint {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-img]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-stage]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-count]')!;
    const tip = dialog.querySelector<HTMLElement>('[data-tip]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
    let items: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const verb = window.matchMedia('(hover: none)').matches ? 'Tap' : 'Click';
    const fits = () => img.naturalWidth <= stage.clientWidth && img.naturalHeight <= stage.clientHeight;

    const updateZoomState = () => {
      const small = !img.naturalWidth || fits();
      img.classList.toggle('is-small', small);
      tip.textContent = small ? '' : dialog.classList.contains('is-actual') ? `${verb} the picture to fit it to the screen` : `${verb} the picture to see it at full size`;
    };

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const el = items[index];
      dialog.classList.remove('is-actual');
      const small = el.dataset.zoomSmall; // shows straight away while the large one loads
      if (small) img.src = small;
      img.alt = el.dataset.zoomAlt || '';
      const large = el.dataset.zoom!;
      const loader = new Image();
      loader.onload = () => {
        if (items[index] === el) {
          img.src = large;
          updateZoomState();
        }
      };
      loader.src = large;
      caption.textContent = el.dataset.zoomCaption || el.dataset.zoomAlt || '';
      count.textContent = items.length > 1 ? `${index + 1} of ${items.length}` : '';
      prev.hidden = next.hidden = items.length < 2;
      updateZoomState();
      el.dispatchEvent(new CustomEvent('lightbox:show', { bubbles: true, detail: { index } }));
    };

    const open = (el: HTMLElement) => {
      const group = el.dataset.zoomGroup;
      items = group ? [...document.querySelectorAll<HTMLElement>(`[data-zoom][data-zoom-group="${CSS.escape(group)}"]`)] : [el];
      opener = el;
      document.documentElement.classList.add('lightbox-open');
      dialog.showModal();
      show(Math.max(0, items.indexOf(el)));
    };

    const close = () => dialog.close();

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      dialog.classList.remove('is-actual');
      const shown = items[index];
      if (shown) shown.dispatchEvent(new CustomEvent('lightbox:close', { bubbles: true, detail: { index } }));
      (shown?.offsetParent ? shown : opener)?.focus({ preventScroll: true });
    });

    document.addEventListener('click', (e) => {
      const el = (e.target as Element).closest<HTMLElement>('[data-zoom]');
      if (!el || dialog.contains(el)) return;
      e.preventDefault();
      open(el);
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', close);

    img.addEventListener('click', () => {
      if (img.classList.contains('is-small')) return;
      dialog.classList.toggle('is-actual');
      updateZoomState();
    });

    // A click on the dark area (not the picture, caption or buttons) closes it
    dialog.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t === dialog || t === stage || t.classList.contains('lightbox__bar')) close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && items.length > 1) show(index - 1);
      else if (e.key === 'ArrowRight' && items.length > 1) show(index + 1);
    });

    let startX = 0;
    let startY = 0;
    dialog.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (dialog.classList.contains('is-actual') || items.length < 2 || e.touches.length) return;
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
    });

    window.addEventListener('resize', () => dialog.open && updateZoomState());
  }
</script>
