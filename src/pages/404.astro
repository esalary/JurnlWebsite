---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="container stack" style="--gap: 20px; max-width: 720px">
      <span class="rule2" aria-hidden="true"></span>
      <h1 class="h2">Page not found</h1>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
      <a class="btn btn--primary" href="/" style="align-self: flex-start">Go to the homepage</a>
    </div>
  </section>
</BaseLayout>
