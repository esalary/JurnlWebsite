---
import { sections, manual } from '../data/site';

interface Props {
  section?: string;
}
const { section } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Jurnl home">
      <img src="/images/logo/jurnl-horizontal.svg" alt="Jurnl" width="124" height="50" />
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        sections.map((s) => (
          <a href={s.href} class={section === s.key ? 'is-active' : undefined}>
            {s.title}
          </a>
        ))
      }
      <a href={manual.href} target="_blank" rel="noopener">Manual</a>
      <a class="btn btn--primary" href="/download/">Download</a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Menu">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <nav class="mobile-nav__panel" aria-label="Main (mobile)">
        {sections.map((s) => <a href={s.href}>{s.title}</a>)}
        <a href="/download/">Download</a>
        <a href={manual.href} target="_blank" rel="noopener">User manual (PDF)</a>
        <a href="/contact/">Contact</a>
      </nav>
    </details>
  </div>
</header>
