---
// App screenshots stacked like a deck: one in front, the next two behind it, each a little lower and
// narrower so their bottom edges show underneath. Click the front screenshot or the arrows to bring
// the next one forward; it cycles through all of them.
import Screenshot from './Screenshot.astro';

interface Shot {
  file: string;
  alt: string;
  caption?: string;
}
interface Props {
  shots: Shot[];
  note?: string; // shown under the captions, e.g. "Made-up business"
}
const { shots, note } = Astro.props;
---

<figure class="shot-stack" data-shot-stack>
  <div class="shot-stack__deck">
    {
      shots.map((s, i) => (
        <div class="shot-stack__card" data-card data-pos={Math.min(i, 3)} aria-hidden={i === 0 ? undefined : 'true'}>
          <Screenshot file={s.file} alt={s.alt} eager={i === 0} />
        </div>
      ))
    }
  </div>
  {
    shots.length > 1 && (
      <figcaption class="shot-stack__bar">
        <button type="button" class="shot-stack__btn" data-prev aria-label="Previous screenshot">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <div class="shot-stack__text">
          <p class="shot-stack__caption" data-caption aria-live="polite">{shots[0].caption ?? shots[0].alt}</p>
          <p class="shot-stack__count"><span data-count>1</span> of {shots.length}{note && <> · {note}</>}</p>
        </div>
        <button type="button" class="shot-stack__btn" data-next aria-label="Next screenshot">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </figcaption>
    )
  }
  <script type="application/json" data-captions set:html={JSON.stringify(shots.map((s) => s.caption ?? s.alt))} />
</figure>

<script>
  for (const stack of document.querySelectorAll<HTMLElement>('[data-shot-stack]')) {
    const cards = [...stack.querySelectorAll<HTMLElement>('[data-card]')];
    if (cards.length < 2) continue;
    const captions: string[] = JSON.parse(stack.querySelector('[data-captions]')?.textContent ?? '[]');
    const captionEl = stack.querySelector<HTMLElement>('[data-caption]');
    const countEl = stack.querySelector<HTMLElement>('[data-count]');
    let front = 0;

    const show = (next: number) => {
      front = (next + cards.length) % cards.length;
      cards.forEach((card, i) => {
        const pos = (i - front + cards.length) % cards.length; // 0 = front
        card.dataset.pos = String(Math.min(pos, 3));
        if (pos === 0) card.removeAttribute('aria-hidden');
        else card.setAttribute('aria-hidden', 'true');
      });
      if (captionEl) captionEl.textContent = captions[front] ?? '';
      if (countEl) countEl.textContent = String(front + 1);
    };

    stack.querySelector('[data-next]')?.addEventListener('click', () => show(front + 1));
    stack.querySelector('[data-prev]')?.addEventListener('click', () => show(front - 1));
    stack.querySelector('.shot-stack__deck')?.addEventListener('click', () => show(front + 1));
    stack.classList.add('is-interactive');
  }
</script>
